{
  "name": "openrouter-mcp",
  "version": "2.0.1",
  "description": "MCP server for consulting AI models via OpenRouter",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "openrouter-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "mcp",
    "openrouter",
    "ai",
    "llm",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minovap/openrouter-mcp.git"
  },
  "license": "MIT",
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@openrouter/sdk": "^0.3.14",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "jest": "^30.3.0"
  },
  "overrides": {
    "ip-address": "10.2.0"
  }
}
